FROM python:{{ python_version }}-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

# System dependencies (libpq is only needed for PostgreSQL)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
{%- if database == 'postgresql' %}
    libpq-dev \
{%- endif %}
    && rm -rf /var/lib/apt/lists/*

# Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Non-root user with a fixed UID/GID so bind mounts stay writable on Linux.
RUN groupadd --gid 1000 app \
    && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash app \
    && mkdir -p /app/static /app/data \
    && chown -R app:app /app

# Application code
COPY --chown=app:app entrypoint.sh /entrypoint.sh
COPY --chown=app:app backend /app/backend
RUN chmod +x /entrypoint.sh

USER app

# Collect static files at build time so the image is self-contained.
# This is a build-only placeholder, never used at runtime.
RUN SECRET_KEY=build-only-secret-not-used-at-runtime-0123456789abcdefghij \
    POSTGRES_PASSWORD=build \
    python backend/manage.py collectstatic --noinput

EXPOSE {{ port }}

ENTRYPOINT ["/entrypoint.sh"]
CMD ["gunicorn", "backend.{{ package_name }}.wsgi:application", "--bind", "0.0.0.0:{{ port }}"]
