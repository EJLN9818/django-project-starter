"""Django settings for {{ project_name }}.

Generated by django-project-starter. Values are read from environment
variables (loaded from a local .env file when present).
"""

from pathlib import Path

import environ
from django.core.exceptions import ImproperlyConfigured

# ---------------------------------------------------------------------------
# Paths and environment
# ---------------------------------------------------------------------------
BASE_DIR = Path(__file__).resolve().parent.parent

env = environ.Env(
    DEBUG=(bool, False),
    ALLOWED_HOSTS=(list, ["localhost", "127.0.0.1"]),
)
# Load .env from the project root if it exists. `utf-8-sig` tolerates the BOM
# that Windows editors sometimes add to the first line.
environ.Env.read_env(BASE_DIR.parent / ".env", encoding="utf-8-sig")

DEBUG = env("DEBUG")
SECRET_KEY = env(
    "SECRET_KEY",
    default="django-insecure-change-me-in-production",
)
if not DEBUG and (
    SECRET_KEY.startswith("django-insecure-")
    or len(SECRET_KEY) < 50
    or len(set(SECRET_KEY)) < 5
):
    raise ImproperlyConfigured(
        "Set a strong SECRET_KEY (at least 50 characters) in .env. Generate one with: "
        'python -c "import secrets; print(secrets.token_urlsafe(50))"'
    )
ALLOWED_HOSTS = env("ALLOWED_HOSTS")

# ---------------------------------------------------------------------------
# Applications
# ---------------------------------------------------------------------------
APPS = [
    "django.contrib.admin",
    "django.contrib.auth",
    "django.contrib.contenttypes",
    "django.contrib.sessions",
    "django.contrib.messages",
    "django.contrib.staticfiles",
]

THIRD_APPS = [
    "django_extensions",
]

INSTALLED_APPS = APPS + THIRD_APPS

MIDDLEWARE = [
    "django.middleware.security.SecurityMiddleware",
    "whitenoise.middleware.WhiteNoiseMiddleware",
    "django.contrib.sessions.middleware.SessionMiddleware",
    "django.middleware.common.CommonMiddleware",
    "django.middleware.csrf.CsrfViewMiddleware",
    "django.contrib.auth.middleware.AuthenticationMiddleware",
    "django.contrib.messages.middleware.MessageMiddleware",
    "django.middleware.clickjacking.XFrameOptionsMiddleware",
]

if DEBUG:
    # The toolbar is installed only in development. It must never be enabled
    # in production because it exposes queries and request data.
    import socket

    INSTALLED_APPS.append("debug_toolbar")
    MIDDLEWARE.insert(0, "debug_toolbar.middleware.DebugToolbarMiddleware")

    INTERNAL_IPS = ["127.0.0.1", "::1"]
    try:
        _, _, addresses = socket.gethostbyname_ex(socket.gethostname())
    except OSError:
        addresses = []
    # In Docker, requests arrive through the bridge gateway (for example
    # 172.18.0.1), not from 127.0.0.1. Add the gateway for each local address.
    INTERNAL_IPS.extend(f"{address.rsplit('.', 1)[0]}.1" for address in addresses)

