services:
  web:
    build: .
    entrypoint: ["/entrypoint.sh"]
    command:
      ["gunicorn", "backend.{{ package_name }}.wsgi:application", "--bind", "0.0.0.0:{{ port }}"]
    volumes:
      - ./backend:/app/backend
      - ./static:/app/static
{%- if database == 'sqlite' %}
      - ./data:/app/data
{%- endif %}
    ports:
      - "{{ port }}:{{ port }}"
    env_file:
      - .env
    environment:
      - DJANGO_SETTINGS_MODULE=backend.{{ package_name }}.settings
{%- if database == 'postgresql' %}
    depends_on:
      db:
        condition: service_healthy
{%- endif %}
    restart: unless-stopped
{%- if database == 'postgresql' %}

  db:
    image: postgres:16-alpine
    environment:
      POSTGRES_DB: ${POSTGRES_DB}
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - postgres_data:/var/lib/postgresql/data/
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped

volumes:
  postgres_data:
{%- endif %}
