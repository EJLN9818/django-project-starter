FROM python:{{ python_version }}-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    DJANGO_SETTINGS_MODULE=backend.{{ package_name }}.settings

WORKDIR /app

# System dependencies. Git is required by pre-commit; libpq only for PostgreSQL.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
{%- if database == 'postgresql' %}
    libpq-dev \
{%- endif %}
    && rm -rf /var/lib/apt/lists/*

# Development dependencies include pytest, Ruff, factory_boy and the runtime stack.
COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements-dev.txt

# Non-root user with a fixed UID/GID so bind mounts stay writable on Linux.
RUN groupadd --gid 1000 app \
    && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash app \
    && mkdir -p /app/static /app/data \
    && chown -R app:app /app

# The source is bind-mounted by compose.dev.yml, but copying it keeps the image
# usable on its own (for example with `docker run`).
COPY --chown=app:app entrypoint.sh /entrypoint.sh
COPY --chown=app:app backend /app/backend
COPY --chown=app:app pyproject.toml /app/pyproject.toml
RUN chmod +x /entrypoint.sh

USER app

# The repository is bind-mounted from the host. Allow Git to inspect it even
# when Docker Desktop reports a different owner for the mounted files.
RUN git config --global --add safe.directory /app

EXPOSE {{ port }}

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "backend/manage.py", "runserver", "0.0.0.0:{{ port }}"]
