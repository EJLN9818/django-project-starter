# Docker-only development overlay. Use it together with docker-compose.yml:
#   docker compose -f docker-compose.yml -f compose.dev.yml up --build
services:
  web:
    build:
      context: .
      dockerfile: Dockerfile.dev
    command:
      ["python", "backend/manage.py", "runserver", "0.0.0.0:{{ port }}"]
    environment:
      DEBUG: "True"
      PRE_COMMIT_HOME: /home/app/.cache/pre-commit
    volumes:
      # Mount the whole repository so Django, pytest and pre-commit can see
      # every project file, not only the backend package.
      - .:/app
      # Persist pre-commit hook environments between container runs.
      - precommit_cache:/home/app/.cache/pre-commit
    restart: "no"

volumes:
  precommit_cache:
