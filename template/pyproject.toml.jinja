# Tool configuration only. Runtime dependencies live in requirements.txt.

[tool.pytest.ini_options]
DJANGO_SETTINGS_MODULE = "backend.{{ package_name }}.settings"
python_files = ["test_*.py"]
testpaths = ["backend"]

[tool.ruff]
line-length = 88
target-version = "py{{ python_version | replace('.', '') }}"
extend-exclude = ["migrations"]

[tool.ruff.lint]
select = ["E", "F", "I", "B", "UP", "DJ"]

[tool.ruff.lint.isort]
known-first-party = ["backend"]

[tool.ruff.format]
quote-style = "double"
