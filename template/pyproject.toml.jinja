[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_name }}"
requires-python = ">={{ python_version }}"
{%- if include_precommit %}
dependencies = [
    "ruff>=0.8.4",
    "black>=24.10.0",
    "pre-commit>=4.0.1",
]
{%- endif %}

[tool.pytest.ini_options]
DJANGO_SETTINGS_MODULE = "backend.{{ package_name }}.settings"
python_files = ["test_*.py"]
testpaths = ["backend"]

[tool.ruff]
line-length = 88
target-version = "py{{ python_version | replace('.', '') }}"
exclude = ["migrations"]

[tool.ruff.lint]
select = ["E", "F", "I", "B", "UP", "DJ"]

[tool.ruff.lint.isort]
known-first-party = ["backend"]

[tool.black]
line-length = 88
target-version = ["py{{ python_version | replace('.', '') }}"]
exclude = "migrations/"
