# Django
# Local runserver: True. Docker Compose overrides this to False.
DEBUG=True
# Generate a strong key (at least 50 characters) with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-change-me-in-production
# Add your LAN IP / hostname here if you access the app from another machine.
ALLOWED_HOSTS=localhost,127.0.0.1
{%- if database == 'postgresql' %}

# Database
POSTGRES_DB={{ postgres_db }}
POSTGRES_USER={{ postgres_user }}
# Set a real password before the first `docker compose up`.
POSTGRES_PASSWORD=change-me
# localhost for `runserver`; Docker Compose overrides this to `db`.
DB_HOST=localhost
DB_PORT=5432
{%- endif %}
