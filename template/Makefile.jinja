# Convenience targets for local development. Requires GNU make.
# (On Windows, use Git Bash or WSL.)
PYTHON ?= python
MANAGE = $(PYTHON) backend/manage.py
COMPOSE ?= docker compose
COMPOSE_DEV = $(COMPOSE) -f docker-compose.yml -f compose.dev.yml

.DEFAULT_GOAL := help
.RECIPEPREFIX = >

.PHONY: help up down build logs ps dev dev-down dev-test dev-lint dev-shell \
        dev-manage migrate makemigrations shell dbshell superuser test lint fmt collectstatic

help: ## Show this help
> @grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-16s\033[0m %s\n", $$1, $$2}'

up: ## Build and start the stack in the background
> $(COMPOSE) up -d --build

down: ## Stop the stack
> $(COMPOSE) down

build: ## Build the images
> $(COMPOSE) build

logs: ## Follow container logs
> $(COMPOSE) logs -f

ps: ## Show running services
> $(COMPOSE) ps

dev: ## Build and start the Docker-only development stack (foreground)
> $(COMPOSE_DEV) up --build

dev-down: ## Stop the development stack
> $(COMPOSE_DEV) down

dev-test: ## Run pytest in the development container
> $(COMPOSE_DEV) run --rm web pytest

dev-lint: ## Check linting and formatting in the development container
> $(COMPOSE_DEV) run --rm web ruff check .
> $(COMPOSE_DEV) run --rm web black --check .

dev-shell: ## Open the Django shell in the development container
> $(COMPOSE_DEV) run --rm web python backend/manage.py shell

dev-manage: ## Run a Django command in the development container (CMD=...)
> $(COMPOSE_DEV) run --rm web python backend/manage.py $(CMD)

migrate: ## Apply database migrations
> $(MANAGE) migrate

makemigrations: ## Create new migrations
> $(MANAGE) makemigrations

shell: ## Open the Django shell
> $(MANAGE) shell

dbshell: ## Open the database shell
> $(MANAGE) dbshell

superuser: ## Create an admin user
> $(MANAGE) createsuperuser

test: ## Run the test suite
> pytest

lint: ## Check linting and formatting
> ruff check .
> black --check .

fmt: ## Auto-fix linting and formatting
> ruff check --fix .
> black .

collectstatic: ## Collect static files
> $(MANAGE) collectstatic --noinput
